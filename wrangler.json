{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "omnis-game",
  "main": "./Cloudflare/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://mqdrcgymylbqozarykip.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_cyZq5_ffkc8j9D_r8QRxNA_dMg3ZLwL"
  },
  "queues": {
    "producers": [
      { "binding": "OMNIS_EVENTS", "queue": "omnis-events" }
    ],
    "consumers": [
      {
        "queue": "omnis-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "omnis-events-dlq",
        "max_concurrency": 5,
        "retry_delay": 10
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true,
      "redact_query_string": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    },
    "issues": { "enabled": true }
  }
}
