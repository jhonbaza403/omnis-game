# Built only from the real UE 5.6 dedicated-server package generated by CI.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive     OMNIS_SERVER_PORT=7777     OMNIS_SERVER_MAP=/Game/Omnis/Maps/Omnis_OpenWorld

RUN apt-get update && apt-get install -y --no-install-recommends       ca-certificates libstdc++6 libgcc-s1 libx11-6 libxrandr2 libxi6 libxcursor1 libxinerama1     && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --home-dir /opt/omnis --shell /usr/sbin/nologin omnis
WORKDIR /opt/omnis/server
COPY Build/OmnisServer/ /opt/omnis/server/
COPY infra/docker/unreal-server/entrypoint.sh /usr/local/bin/omnis-server-entrypoint
RUN chmod +x /usr/local/bin/omnis-server-entrypoint && chown -R omnis:omnis /opt/omnis
USER omnis
EXPOSE 7777/udp
ENTRYPOINT ["/usr/local/bin/omnis-server-entrypoint"]
