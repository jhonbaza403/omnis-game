{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnis-game",
  "main": "./Cloudflare/worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,

  "vars": {
    "OMNIS_ENVIRONMENT": "production"
  },

  "queues": {
    "producers": [
      {
        "binding": "OMNIS_EVENTS",
        "queue": "omnis-events"
      }
    ],
    "consumers": [
      {
        "queue": "omnis-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "omnis-events-dlq",
        "max_concurrency": 5,
        "retry_delay": 10
      }
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  "previews": {
    "vars": {
      "OMNIS_ENVIRONMENT": "preview"
    },
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": true
      }
    }
  }
}
